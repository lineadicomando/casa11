# Configurazione di docker compose. Si attiva copiando il file:
#
#   cp .env.example .env
#
# Senza .env valgono i valori predefiniti indicati qui sotto.

# Porte pubblicate sull'host.
WEB_PORT=3000
DEV_PORT=5173

# Dove vive il database delle località (~90 MB), che non sta nell'immagine.
#
# Due modi, e la differenza è solo il valore di questa variabile:
#
#   geonames                 volume gestito da Docker, popolato da
#                            `docker compose --profile setup run --rm geo-import`.
#                            Non serve Node installato sull'host.
#
#   ./packages/geo/data      cartella dell'host: riusa il dataset già
#                            importato con `npm run geo:import`, ed è la scelta
#                            comoda se si lavora anche fuori dai container.
#
# Qualsiasi percorso che inizi per `.` o `/` viene montato come bind; ogni
# altro valore è inteso come nome di volume e va dichiarato in compose.yaml.
GEONAMES_DATA=geonames
